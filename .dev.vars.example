SCAN_GATE_FROM_EMAIL=gaurav@revforgehq.com

# GTM — SyncGTM email enrichment (scripts/enrich_leads_syncgtm.py)
SYNCGTM_API_KEY=

# CRM — Google Sheet backup sync (Neon → Sheet daily)
GOOGLE_SERVICE_ACCOUNT_JSON=
CRM_SPREADSHEET_ID=16lpxRX-flWP_blM_Rvq-_rc6ktZFUvBpjqp7eCmLtWs
CRM_SHEET_LEADS=Leads
CRM_SHEET_ACCOUNTS=Accounts
CRM_SHEET_OUTREACH=Outreach

# GTM — Account news enrichment (daily cron + /api/crm/news-enrich)
